// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  uuid         String      @id @default(uuid())
  slug         String      @unique
  title        String
  excerpt      String
  content      String
  author_id    String
  category_id  String
  status       String      @default("draft")
  is_featured  Boolean     @default(false)
  read_time    Int         @default(5)
  published_at DateTime    @default(now())
  image        String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  author   BlogAuthor   @relation(fields: [author_id], references: [uuid])
  category BlogCategory @relation(fields: [category_id], references: [uuid])
  tags     BlogTag[]

  @@index([author_id])
  @@index([category_id])
}

model BlogAuthor {
  uuid    String     @id @default(uuid())
  name    String
  email   String     @unique
  bio     String?
  avatar  String?
  posts   BlogPost[]

  @@index([email])
}

model BlogCategory {
  uuid    String     @id @default(uuid())
  name    String     @unique
  slug    String     @unique
  posts   BlogPost[]

  @@index([slug])
}

model BlogTag {
  uuid    String     @id @default(uuid())
  name    String     @unique
  slug    String     @unique
  posts   BlogPost[]

  @@index([slug])
}

model Affiliate {
  id                      String                 @id @default(uuid())
  partner_id              String                 @unique
  full_name               String
  whatsapp_phone          String                 @unique
  city_state              String
  promotion_channel       String
  custom_handle           String
  partner_code            String                 @unique
  referral_link           String
  tier                    String                 @default("Starter (5.0%)")
  commission_rate         Decimal                @default(0.05) @db.Decimal(4, 2)
  total_sales_count       Int                    @default(0)
  total_revenue_generated Decimal                @default(0.00) @db.Decimal(14, 2)
  total_commission_earned Decimal                @default(0.00) @db.Decimal(14, 2)
  is_active               Boolean                @default(true)
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt

  bank_accounts           AffiliateBankAccount[]
  orders                  CustomerOrder[]
  payouts                 CommissionPayout[]

  @@index([partner_code])
  @@index([whatsapp_phone])
  @@index([partner_id])
}

model AffiliateBankAccount {
  id                     String    @id @default(uuid())
  affiliate_id           String
  bank_name              String
  nuban_account_number   String
  account_name_resolved  String
  is_verified            Boolean   @default(true)
  created_at             DateTime  @default(now())

  affiliate              Affiliate @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)

  @@index([affiliate_id])
  @@index([nuban_account_number])
}

model ReferralClick {
  id               String    @id @default(uuid())
  partner_code     String
  visitor_ip_hash  String?
  user_agent       String?
  utm_source       String?
  landing_page     String?
  clicked_at       DateTime  @default(now())

  @@index([partner_code])
}

model CustomerOrder {
  id                      String     @id @default(uuid())
  order_number            String     @unique
  customer_name           String
  customer_phone          String
  delivery_city           String
  delivery_state          String
  powerbox_model          String
  combo_retail_price      Decimal    @db.Decimal(12, 2)
  voucher_code_applied    String?
  voucher_discount_amount Decimal    @default(5000.00) @db.Decimal(10, 2)
  final_amount_paid       Decimal    @db.Decimal(12, 2)
  affiliate_id            String?
  commission_rate_applied Decimal    @db.Decimal(4, 2)
  commission_amount       Decimal    @db.Decimal(12, 2)
  order_status            String     @default("Confirmed")
  is_settled              Boolean    @default(false)
  created_at              DateTime   @default(now())

  affiliate               Affiliate? @relation(fields: [affiliate_id], references: [id])

  @@index([order_number])
  @@index([voucher_code_applied])
  @@index([affiliate_id])
}

model CommissionPayout {
  id                      String    @id @default(uuid())
  settlement_cycle_date   DateTime
  affiliate_id            String
  total_payout_amount     Decimal   @db.Decimal(12, 2)
  bank_name               String
  nuban_account_number    String
  payment_status          String    @default("Queued")
  bank_transfer_reference String?
  paid_at                 DateTime?
  created_at              DateTime  @default(now())

  affiliate               Affiliate @relation(fields: [affiliate_id], references: [id])

  @@index([affiliate_id])
  @@index([settlement_cycle_date])
}
 